{
  "name": "ling-desktop",
  "productName": "Ling",
  "version": "1.64.1",
  "description": "全局悬浮小球：点击识别当前屏幕 / 划词翻译 → 半透明悬浮答案",
  "main": "main.js",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js && node tool/smoke-main.js main.js",
    "pack:mac": "electron-builder --mac zip --arm64 --publish never",
    "pack:win": "electron-builder --win zip --x64 --publish never",
    "pack": "npm run pack:mac && npm run pack:win"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ling.opensource",
    "productName": "Ling",
    "asar": true,
    "files": [
      "main.js",
      "extras.js",
      "update.js",
      "prompts.js",
      "themes.js",
      "math.js",
      "fsrs.js",
      "knowledge.js",
      "anki.js",
      "preload.js",
      "ui.css",
      "selcopy.js",
      "panelgrow.js",
      "orb.html",
      "answer.html",
      "hint.html",
      "menu.html",
      "scan.html",
      "ask.html",
      "translate.html",
      "review.html",
      "block.png",
      "package.json",
      "settings.html",
      "qr.js",
      "lan-merge.js",
      "lan-store.js",
      "lan-sync.js",
      "settings-search.js",
      "knowledge-search.js",
      "mcp-hub.js",
      "mcp-auth.js",
      "mcp-audit.js",
      "mcp-tools.js",
      "mcp-review-prompt.js",
      "ling-link.js",
      "ling-mcp-bridge.js",
      "voice-asr.js",
      "voice-secrets.js",
      "voice-main.js",
      "voice-preload.js",
      "voice-worklet.js",
      "voice-dialogue.js",
      "voice-prefs.js",
      "tencent-speech.js",
      "focusguard-main.js",
      "companion-main.js",
      "bubble.html",
      "voice.html",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "electronLanguages": [
        "zh-CN",
        "en"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ling 需要麦克风权限来做实时语音转写（只在你点「开始转写」或「开始对话」后录音，音频直接上传给你选定的转写服务，不在本机保存）。",
        "NSAudioCaptureUsageDescription": "Ling 需要「系统音频录制」权限来转写会议里对方的声音（只在你点「开始转写」并选「系统声音」或「会议双方」后采集系统声音，画面不读取、不上传、不保存；音频直接上传给你选定的转写服务，不在本机保存）。",
        "NSCameraUsageDescription": null,
        "NSBluetoothAlwaysUsageDescription": null,
        "NSBluetoothPeripheralUsageDescription": null
      }
    },
    "npmRebuild": false,
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "author": "Ling contributors",
  "engines": {
    "node": ">=24.0.0"
  }
}
